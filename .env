# Configurações do Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=logmov_db
DB_USER=root
DB_PASS=rootpassword

# Configurações de Segurança e JWT
JWT_SECRET=super_secret_logmov_key_2026_change_in_production!#@
JWT_EXPIRATION_TIME=28800

# Tempo de expiração do Token de Redefinição de Senha (em minutos)
